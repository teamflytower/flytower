// The website runs as a Cloudflare Worker. Pages are prerendered at build time and served as
// static assets; the Worker runs the server routes (the mailing list sign-up).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flytower-site",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Deploying creates the DNS record and certificate for the domain on first run.
  "routes": [{ "pattern": "flytower.dev", "custom_domain": true }],
  // The mailing list service. The site checks each sign-up, then hands the address over this
  // binding. Pull request previews bind the staging service instead (see site.yml).
  "services": [{ "binding": "LISTS", "service": "platform-api", "entrypoint": "Lists" }],
  // At most 5 sign-up attempts per IP address a minute. The address is a counter key only.
  "ratelimits": [
    {
      "name": "NEWSLETTER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // The Turnstile secret lives in the account's Secrets Store, outside Worker versions.
  "secrets_store_secrets": [
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "f52e1e82a35c482697dc96def22ab8f3",
      "secret_name": "TURNSTILE_SECRET_KEY",
    },
  ],
  "observability": { "enabled": true },
  "preview_urls": true,
  "workers_dev": true,
}
